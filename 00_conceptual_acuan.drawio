<mxfile host="app.diagrams.net"><diagram name="Conceptual ERD" id="conceptual"><mxGraphModel dx="1250" dy="1250" grid="1" gridSize="10" page="1" pageWidth="1250" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Conceptual ERD acuan" style="text;html=0;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="20" width="1100" height="45" /></mxCell><mxCell id="instruction" value="Lengkapi nama relasi dan kardinalitas kedua ujung. Tampilkan atribut dan key tanpa tipe vendor." style="text;html=0;fontSize=14;whiteSpace=wrap;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="70" width="1100" height="40" /></mxCell><mxCell id="peserta" value="Peserta&#10;&#10;Identitas peserta&#10;Nama&#10;Kota" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#EDF5F9;strokeColor=#1F497D;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="150" width="300" height="210" /></mxCell><mxCell id="polis" value="Polis&#10;&#10;Nomor polis&#10;Tanggal mulai&#10;Tanggal akhir" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#EDF5F9;strokeColor=#1F497D;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="150" width="320" height="330" /></mxCell><mxCell id="produk" value="Produk&#10;&#10;Identitas produk&#10;Nama produk" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#EDF5F9;strokeColor=#1F497D;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="875" y="150" width="300" height="200" /></mxCell><mxCell id="kontribusi" value="Kontribusi&#10;&#10;Identitas transaksi&#10;Tanggal kontribusi&#10;Jumlah&#10;Status" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#EDF5F9;strokeColor=#1F497D;align=left;verticalAlign=top;spacing=14;fontFamily=Helvetica;fontSize=16;" ver